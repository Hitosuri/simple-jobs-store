# Copy to .env. Durations are milliseconds; paths are relative to be/.
JOBS_STORE_HOST=127.0.0.1
JOBS_STORE_PORT=8000
JOBS_STORE_DB_PATH=jobs.db
JOBS_STORE_WORKER_LEASE_MS=30000
JOBS_STORE_JOB_LEASE_MS=30000
JOBS_STORE_DEFAULT_MAX_RUN_MS=86400000
JOBS_STORE_DEFAULT_MAX_ATTEMPT=3
JOBS_STORE_BACKOFF_BASE_MS=1000
JOBS_STORE_BACKOFF_CAP_MS=300000
JOBS_STORE_CLEANUP_INTERVAL_MS=5000
JOBS_STORE_RETENTION_MS=604800000
