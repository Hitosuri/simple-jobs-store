# Copy to .env. One file for both `uv run` and `docker compose`, run from the repo root.
# Durations are milliseconds; paths are relative to the repo root.
JOBS_STORE_HOST=127.0.0.1
JOBS_STORE_PORT=8000
# Directory holding jobs.db. Create it first, neither the store nor compose will:
#   mkdir -p ./data && sudo chown 999:999 ./data   (chown only for Docker on Linux: container uid 999)
JOBS_STORE_DATA_DIR=./data
JOBS_STORE_WORKER_LEASE_MS=30000
JOBS_STORE_JOB_LEASE_MS=30000
JOBS_STORE_DEFAULT_MAX_RUN_MS=86400000
JOBS_STORE_DEFAULT_MAX_ATTEMPT=3
JOBS_STORE_BACKOFF_BASE_MS=1000
JOBS_STORE_BACKOFF_CAP_MS=300000
JOBS_STORE_CLEANUP_INTERVAL_MS=5000
JOBS_STORE_RETENTION_MS=604800000
JOBS_STORE_REPORT_MAX_ROUNDS=3
JOBS_STORE_REPORT_TIMEOUT_MS=10000
JOBS_STORE_REPORT_BACKOFF_BASE_MS=10000
JOBS_STORE_REPORT_BACKOFF_CAP_MS=600000
